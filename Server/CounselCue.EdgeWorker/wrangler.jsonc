{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "counselcue-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "OPENROUTER_MODEL": "openai/gpt-5.6-terra",
    "ELEVENLABS_VOICE_ID": "21m00Tcm4TlvDq8ikWAM",
    // Per-case client voices (caseId -> ElevenLabs voice id). Cases without an
    // entry fall back to ELEVENLABS_VOICE_ID. Pick voices that match each
    // client's age and gender, e.g. "adolescent-pressure-01": "<voice id>".
    "ELEVENLABS_VOICE_IDS": {},
  },
  "ratelimits": [
    {
      "name": "TURN_LIMITER",
      "namespace_id": "71017",
      "simple": { "limit": 15, "period": 60 },
    },
    {
      // Ceiling per network address across all sessions (e.g. a classroom NAT).
      "name": "TURN_IP_LIMITER",
      "namespace_id": "71019",
      "simple": { "limit": 240, "period": 60 },
    },
    {
      "name": "VOICE_LIMITER",
      "namespace_id": "71018",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
}
