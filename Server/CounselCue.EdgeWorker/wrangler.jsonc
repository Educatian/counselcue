{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "counselcue-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "OPENROUTER_MODEL": "openai/gpt-5.6-terra",
    "ELEVENLABS_VOICE_ID": "21m00Tcm4TlvDq8ikWAM",
    // Per-case client voice overrides (caseId -> ElevenLabs voice id). Cases without
    // an entry use the worker's built-in age/gender-matched premade voice
    // (DEFAULT_VOICES), then ELEVENLABS_VOICE_ID, e.g. "adolescent-pressure-01": "<voice id>".
    "ELEVENLABS_VOICE_IDS": {},
    // Expression pipeline (src/affect.js). Voice provider: "gemini" (Gemini 3.8 Flash TTS,
    // needs GEMINI_API_KEY) or "elevenlabs". Defaults apply when the browser sends no controls.
    "VOICE_PROVIDER": "gemini",
    "GEMINI_TTS_MODEL": "gemini-3.8-flash-tts",
    "EXPRESSION_DEFAULTS": { "expressivity": "natural", "vocalEvents": true },
  },
  "ratelimits": [
    {
      "name": "TURN_LIMITER",
      "namespace_id": "71017",
      "simple": { "limit": 15, "period": 60 },
    },
    {
      // Ceiling per network address across all sessions (e.g. a classroom NAT).
      "name": "TURN_IP_LIMITER",
      "namespace_id": "71019",
      "simple": { "limit": 240, "period": 60 },
    },
    {
      "name": "VOICE_LIMITER",
      "namespace_id": "71018",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      // Ceiling per network address across all pages (e.g. a classroom NAT).
      "name": "VOICE_IP_LIMITER",
      "namespace_id": "71020",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
}
