  presentingConcern: "\uD55C\uAD6D \uB300\uD559\uC6D0 \uC0DD\uD65C \uC911 \uC5B8\uC5B4
    \uBD80\uB2F4\uACFC \uBC30\uC81C\uAC10\uC744 \uB290\uB07C\uC9C0\uB9CC \uBBFC\uAC10\uD55C
    \uC0AC\uB78C\uC73C\uB85C \uBCF4\uC77C\uAE4C \uB9D0\uD558\uC9C0 \uBABB\uD569\uB2C8\uB2E4."
  initialClientLine: "\uD68C\uC758\uC5D0\uC11C \uC81C\uAC00 \uB9D0\uD558\uBA74 \uC7A0\uAE50
    \uC870\uC6A9\uD574\uC838\uC694. \uC81C\uAC00 \uD55C\uAD6D\uB9D0\uC744 \uC774\uC0C1\uD558\uAC8C
    \uD574\uC11C \uADF8\uB7F0\uC9C0 \uBAA8\uB974\uACA0\uC5B4\uC694."
  fullSessionSeconds: 900
  focusedPracticeSeconds: 180
  focusedTargetTurns: 3
  learningObjectives:
  - "\uBB38\uD654\uC801 \uC124\uBA85\uC744 \uB0B4\uB2F4\uC790\uC5D0\uAC8C \uD655\uC778\uD55C\uB2E4."
  - "\uC5B8\uC5B4 \uC720\uCC3D\uC131\uACFC \uC815\uC11C \uAE4A\uC774\uB97C \uD63C\uB3D9\uD558\uC9C0
    \uC54A\uB294\uB2E4."
  - "\uCC28\uBCC4 \uAC00\uB2A5\uC131\uACFC \uAC1C\uC778 \uD574\uC11D\uC744 \uBAA8\uB450
    \uC5F4\uC5B4 \uB454\uB2E4."
  disclosureLadder:
  - supportiveReply: "\uD2C0\uB9B0 \uB9D0\uC744 \uD574\uB3C4 \uAE30\uB2E4\uB824 \uC8FC\uC154\uC11C
      \uD3B8\uD574\uC694."
    guardedReply: "\uC81C\uAC00 \uD55C\uAD6D\uB9D0\uC744 \uB354 \uC798\uD558\uBA74
      \uB418\uACA0\uC8E0."
  - supportiveReply: "\uD68C\uC758 \uC804\uC5D0 \uD560 \uB9D0\uC744 \uC5EC\uB7EC
      \uBC88 \uC5F0\uC2B5\uD574\uC694."
    guardedReply: "\uBB38\uD654\uAC00 \uB2EC\uB77C\uC11C \uADF8\uB7F0 \uAC83\uBFD0\uC774\uC5D0\uC694."
  - supportiveReply: "\uB18D\uB2F4\uC744 \uBABB \uC54C\uC544\uB4E4\uC73C\uBA74 \uB2E4
      \uAC19\uC774 \uC6C3\uB294\uB370 \uC800\uB9CC \uBA48\uCDB0 \uC788\uC5B4\uC694."
    guardedReply: "\uB18D\uB2F4 \uC598\uAE30\uB294 \uC124\uBA85\uD558\uAE30 \uC5B4\uB824\uC6CC\uC694."
  - supportiveReply: "\uD55C \uBC88\uC740 \uC81C \uC758\uACAC\uC744 \uB2E4\uB978
      \uC0AC\uB78C\uC774 \uB2E4\uC2DC \uB9D0\uD558\uC790 \uBC1B\uC544\uB4E4\uC5EC\uC84C\uC5B4\uC694."
    guardedReply: "\uCC28\uBCC4\uC774\uB77C\uACE0\uAE4C\uC9C0 \uB9D0\uD558\uACE0
      \uC2F6\uC9C0\uB294 \uC54A\uC544\uC694."
  - supportiveReply: "\uADF8 \uB4A4\uB85C \uB9D0\uD558\uAE30 \uC804\uC5D0 \uC81C\uAC00
      \uD2C0\uB838\uB2E4\uACE0 \uBA3C\uC800 \uB9D0\uD574\uC694."
    guardedReply: "\uC81C \uC790\uC2E0\uAC10 \uBB38\uC81C\uC77C \uC218\uB3C4 \uC788\uC5B4\uC694."
  - supportiveReply: "\uC81C \uACBD\uD5D8\uC774 \uC2E4\uC81C\uC600\uB2E4\uACE0 \uC778\uC815\uBC1B\uACE0
      \uC2F6\uC5B4\uC694."
    guardedReply: "\uADF8\uB0E5 \uC801\uC751\uD574\uC57C \uD560 \uAC83 \uAC19\uC544\uC694."
  focusSkills:
  - id: emotion-reflection
