  initialClientLine: "\uC9D1\uC5D0 \uB4E4\uC5B4\uAC00\uBA74 \uB108\uBB34 \uC870\uC6A9\uD569\uB2C8\uB2E4.
    \uC790\uC2DD\uB4E4\uD55C\uD14C \uC774\uB7F0 \uB9D0\uAE4C\uC9C0 \uD560 \uC218\uB294
