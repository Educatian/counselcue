  focusedPracticeSeconds: 180
  focusedTargetTurns: 3
  learningObjectives:
  - "\uC0AC\uBCC4\uC758 \uC18D\uB3C4\uC640 \uCE68\uBB35\uC744 \uC874\uC911\uD55C\uB2E4."
  - "\uC678\uB85C\uC6C0\uACFC \uC77C\uC0C1 \uAE30\uB2A5\uC744 \uAD6C\uBD84\uD574
    \uD0D0\uC0C9\uD55C\uB2E4."
  - "\uC790\uB140 \uAD00\uACC4\uC5D0 \uB300\uD55C \uAC00\uC815\uC744 \uD53C\uD55C\uB2E4."
  disclosureLadder:
  - supportiveReply: "\uAE30\uB2E4\uB824 \uC8FC\uC2DC\uB2C8 \uADF8 \uC0AC\uB78C \uC0DD\uAC01\uC744
      \uC870\uAE08 \uD574\uBCFC \uC218 \uC788\uB124\uC694."
    guardedReply: "\uB098\uC774 \uB4E4\uBA74 \uB2E4 \uADF8\uB7F0 \uAC70\uC8E0."
  - supportiveReply: "\uC544\uCE68\uC5D0 \uB208\uB728\uB294 \uC2DC\uAC04\uC774 \uC81C\uC77C
      \uD798\uB4ED\uB2C8\uB2E4."
    guardedReply: "\uADF8 \uC0AC\uB78C \uC598\uAE30\uB294 \uADF8\uB9CC\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - supportiveReply: "\uAC19\uC774 \uB9C8\uC2DC\uB358 \uCC28\uB97C \uC544\uC9C1 \uB450
      \uC794 \uC900\uBE44\uD560 \uB54C\uAC00 \uC788\uC5B4\uC694."
    guardedReply: "\uBCC4\uC77C \uC544\uB2D9\uB2C8\uB2E4."
  - supportiveReply: "\uC544\uC774\uB4E4\uC740 \uBC14\uBE60 \uBCF4\uC5EC\uC11C \uC804\uD654\uB97C
      \uB9DD\uC124\uC785\uB2C8\uB2E4."
    guardedReply: "\uC544\uC774\uB4E4\uC740 \uBC14\uC069\uB2C8\uB2E4. \uAD1C\uD788
      \uADC0\uCC2E\uAC8C \uD558\uBA74 \uC548 \uB418\uC8E0."
  - supportiveReply: "\uC694\uC998\uC740 \uB07C\uB2C8\uB97C \uC790\uC8FC \uAC70\uB985\uB2C8\uB2E4."
    guardedReply: "\uBC25\uC740 \uC54C\uC544\uC11C \uBA39\uC2B5\uB2C8\uB2E4."
  - supportiveReply: "\uB204\uAD70\uAC00\uC640 \uC77C\uC8FC\uC77C\uC5D0 \uD55C \uBC88\uC774\uB77C\uB3C4
      \uC774\uC57C\uAE30\uD558\uBA74 \uC88B\uACA0\uC2B5\uB2C8\uB2E4."
    guardedReply: "\uB3C4\uC6C0\uC744 \uBC1B\uC744 \uC815\uB3C4\uB294 \uC544\uB2D9\uB2C8\uB2E4."
  focusSkills:
  - id: emotion-reflection
    label: "\uAC10\uC815 \uBC18\uC601"
    objective: "\uAC10\uC815\uACFC \uC758\uBBF8\uB97C \uAD6C\uCCB4\uC801\uC73C\uB85C
      \uBC18\uC601\uD55C\uB2E4."
    coachingPrompt: "\uAC10\uC815 \uB2E8\uC5B4\uC640 \uADF8 \uC758\uBBF8\uB97C \uD55C
      \uBB38\uC7A5\uC5D0 \uB2F4\uC544 \uBCF4\uC138\uC694."
